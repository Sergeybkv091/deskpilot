{
  "name": "deskpilot",
  "version": "1.0.0",
  "description": "DeskPilot — офисный пульт: заметки, будильники, график смен, помодоро",
  "private": true,
  "scripts": {
    "gen:beep": "node scripts/gen-beep.js",
    "gen:assets": "npx @capacitor/assets generate --android",
    "android:add": "cap add android",
    "sync": "cap sync android",
    "open": "cap open android",
    "patch": "node scripts/patch-manifest.js",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew bundleRelease",
    "apk": "npm run gen:beep && npx cap add android && npm run gen:assets && npm run sync && npm run patch && npm run build:debug"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3"
  }
}
